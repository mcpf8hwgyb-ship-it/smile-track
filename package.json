{
  "name": "smile-track",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "preview": "node scripts/preview.mjs",
    "test:e2e": "playwright test",
    "validate": "npm run lint && npm run typecheck && npm run test:education && npm run test:f02 && npm run build && npm run check:export && npm run test:e2e",
    "test:smoke-sensitivity": "node scripts/check-smoke-sensitivity.mjs",
    "test:f02": "node --experimental-strip-types --test internal/f02/conformance.test.ts internal/f02/boundary.test.mjs",
    "test:f02:controlled": "node internal/f02/require-data.mjs && npm run test:f02",
    "f02:serve": "node internal/f02/server.mjs",
    "f02:browser": "node internal/f02/browser-check.mjs",
    "check:export": "node scripts/check-export-boundary.mjs && node --experimental-strip-types scripts/check-education-export.mjs",
    "test:education": "node --experimental-strip-types --test education/contract.test.ts",
    "test:education-sensitivity": "node --experimental-strip-types scripts/check-education-sensitivity.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "zod": "4.6.6"
  }
}
